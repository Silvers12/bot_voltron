# Token du bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# ID de l'application (Developer Portal > General Information > Application ID)
DISCORD_CLIENT_ID=
# ID du serveur de test (clic droit sur le serveur > Copier l'identifiant). Optionnel :
# si renseigné, les commandes sont déployées instantanément sur ce serveur uniquement.
DISCORD_GUILD_ID=
