# --- Discord ---
# Token du bot (Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Serveur unique autorisé : toute interaction venant d'ailleurs est refusée
DISCORD_GUILD_ID=
# Identifiants Discord autorisés à utiliser /admin, séparés par des virgules.
# Vide = tous les membres ayant la permission Administrateur.
DISCORD_ADMIN_IDS=

# --- Base de données ---
# Mot de passe PostgreSQL (utilisé par docker compose)
POSTGRES_PASSWORD=voltron
# URL vue depuis la machine hôte (dev : `npm run dev` avec `docker compose up -d postgres`)
DATABASE_URL=postgresql://voltron:voltron@localhost:5432/voltron

# --- Divers ---
LOG_LEVEL=info
