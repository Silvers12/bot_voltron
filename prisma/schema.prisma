generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Un membre du serveur. Créé automatiquement à l'arrivée, à la synchronisation
/// au démarrage, ou à la première interaction avec le bot.
model Member {
  id            String    @id @default(cuid())
  guildId       String
  discordUserId String
  /// Dernier pseudo Discord connu (nom de compte)
  username      String
  /// Dernier nom affiché connu sur le serveur
  displayName   String
  /// Date d'arrivée sur le serveur Discord
  joinedAt      DateTime?
  /// Date de départ si le membre a quitté le serveur (null = présent)
  leftAt        DateTime?
  /// Dernière interaction avec le bot
  lastSeenAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       Account?

  dailyClaims   DailyClaim[]

  @@unique([guildId, discordUserId])
  @@index([guildId, leftAt])
}

/// Réglages du serveur modifiables par les administrateurs.
model GuildSettings {
  guildId          String   @id
  currencySingular String   @default("cœur")
  currencyPlural   String   @default("cœurs")
  currencySymbol   String   @default("❤️")
  /// Solde offert à l'ouverture d'une bourse
  startingBalance  Int      @default(5000)
  /// Montant de la récompense quotidienne
  dailyAmount      Int      @default(100)
  /// Fuseau servant à définir le « jour » (récompense quotidienne)
  timezone         String   @default("Europe/Paris")
  updatedAt        DateTime @updatedAt
}

/// Compte bancaire d'un membre. Le solde ne peut jamais être négatif (contrainte en base).
model Account {
  id           String        @id @default(cuid())
  memberId     String        @unique
  member       Member        @relation(fields: [memberId], references: [id])
  balance      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

enum TransactionType {
  WELCOME
  DAILY
  ADMIN_CREDIT
  ADMIN_DEBIT
  HUG_SENT
  HUG_RECEIVED
}

/// Mouvement sur un compte : montant signé, solde résultant, auteur et motif.
model Transaction {
  id             String          @id @default(cuid())
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id])
  type           TransactionType
  delta          Int
  balanceAfter   Int
  reason         String?
  /// Discord ID de la personne à l'origine du mouvement
  actorDiscordId String
  /// Autre partie d'un câlin (Discord ID du destinataire ou de l'expéditeur)
  counterpartyDiscordId String?
  createdAt      DateTime        @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

/// Réclamation de la récompense quotidienne : une seule par membre et par jour civil.
model DailyClaim {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  /// Jour civil dans le fuseau du serveur, format AAAA-MM-JJ
  dayKey        String
  transactionId String   @unique
  createdAt     DateTime @default(now())

  @@unique([memberId, dayKey])
}
