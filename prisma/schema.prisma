generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Un membre du serveur. Créé automatiquement à l'arrivée, à la synchronisation
/// au démarrage, ou à la première interaction avec le bot.
model Member {
  id            String    @id @default(cuid())
  guildId       String
  discordUserId String
  /// Dernier pseudo Discord connu (nom de compte)
  username      String
  /// Dernier nom affiché connu sur le serveur
  displayName   String
  /// Date d'arrivée sur le serveur Discord
  joinedAt      DateTime?
  /// Date de départ si le membre a quitté le serveur (null = présent)
  leftAt        DateTime?
  /// Dernière interaction avec le bot
  lastSeenAt    DateTime  @default(now())
  /// Expérience communautaire (messages + vocal)
  xp            Int       @default(0)
  /// Niveau atteint (dérivé de l'XP, stocké pour détecter les montées)
  level         Int       @default(0)
  messageCount  Int       @default(0)
  /// Temps total passé en vocal, en secondes
  voiceSeconds  Int       @default(0)
  /// Dernier message ayant rapporté de l'XP (anti-spam)
  lastMessageXpAt DateTime?
  voiceSession  VoiceSession?
  blackjackGames BlackjackGame[]
  groupHugs     GroupHugParticipant[]
  duelsSent     Duel[]    @relation("DuelChallenger")
  duelsReceived Duel[]    @relation("DuelOpponent")
  lotteryEntries LotteryEntry[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  account       Account?

  dailyClaims   DailyClaim[]
  weeklyClaims  WeeklyClaim[]
  inventory     InventoryItem[]
  achievements  MemberAchievement[]
  /// Compteurs de machine à sous (source fiable pour les succès)
  /// Titre porté (article de type TITLE possédé)
  titleItemId   String?
  title         ShopItem? @relation("MemberTitle", fields: [titleItemId], references: [id])
  slotSpins     Int       @default(0)
  slotJackpots  Int       @default(0)

  @@unique([guildId, discordUserId])
  @@index([guildId, leftAt])
  @@index([guildId, xp(sort: Desc)])
}

/// Réglages du serveur modifiables par les administrateurs.
model GuildSettings {
  guildId          String   @id
  currencySingular String   @default("cœur")
  currencyPlural   String   @default("cœurs")
  currencySymbol   String   @default("❤️")
  /// Solde offert à l'ouverture d'une bourse
  startingBalance  Int      @default(5000)
  /// Montant de base de la récompense quotidienne
  dailyAmount      Int      @default(200)
  /// Bonus en % par jour de série (jour 1 : 0 %, jour 2 : 2 %, jour 3 : 3 %…), multiplicateur
  dailyStreakBonusPercent Int @default(1)
  /// Montant de la récompense hebdomadaire (semaine civile, lundi → dimanche)
  weeklyAmount     Int      @default(2000)
  /// Fuseau servant à définir le « jour » (récompense quotidienne)
  timezone         String   @default("Europe/Paris")
  /// XP gagnée par message éligible
  xpPerMessage     Int      @default(1)
  /// Délai minimal entre deux messages comptés (0 = tous les messages comptent)
  xpMessageCooldownSeconds Int @default(60)
  /// XP gagnée par tranche de vocal
  xpPerVoiceInterval Int    @default(1)
  /// Durée d'une tranche de vocal, en minutes
  voiceIntervalMinutes Int  @default(30)
  /// Mises autorisées au blackjack
  blackjackMinBet  Int      @default(10)
  blackjackMaxBet  Int      @default(2000)
  /// Prix fixe d'un tour de machine à sous
  slotBet          Int      @default(50)
  /// Mises autorisées en duel
  duelMinStake     Int      @default(10)
  duelMaxStake     Int      @default(5000)
  /// Tombola : salon d'annonce du tirage (null = désactivée)
  lotteryChannelId String?
  lotteryTicketPrice Int    @default(100)
  /// Tickets maximum par membre et par tirage (0 = illimité)
  lotteryMaxTickets Int     @default(10)
  /// Jour ISO (1 = lundi … 7 = dimanche) et heure locale du tirage
  lotteryDrawWeekday Int    @default(7)
  lotteryDrawHour  Int      @default(20)
  /// Amorce ajoutée par la banque à chaque nouveau tirage
  lotterySeed      Int      @default(0)
  /// Rappel de milieu de semaine : jour ISO (0 = aucun) et heure locale
  lotteryReminderWeekday Int @default(3)
  lotteryReminderHour Int    @default(18)
  /// Dernier rappel, en heures avant le tirage (0 = aucun)
  lotteryLastCallHours Int   @default(2)
  /// Part de la cagnotte remportée par un triple autre que les loutres (en %)
  slotTriplePercent Int     @default(50)
  /// Montant de départ de la cagnotte après un jackpot
  slotJackpotSeed  Int      @default(1000)
  /// Câlin collectif : salons d'apparition, tirés au hasard (vide = désactivé)
  groupHugChannelIds String[] @default([])
  /// Cœurs par câlineur, multipliés par le nombre de câlineurs
  groupHugReward   Int      @default(200)
  groupHugDurationSeconds Int @default(60)
  /// Intervalle aléatoire entre deux apparitions, en minutes
  groupHugMinIntervalMinutes Int @default(60)
  groupHugMaxIntervalMinutes Int @default(360)
  /// Prochaine apparition programmée (persistée pour survivre aux redémarrages)
  nextGroupHugAt   DateTime?
  /// Courbe de niveaux : XP pour passer du niveau L au niveau L+1 = base + pas × L
  levelBaseXp      Int      @default(20)
  levelStepXp      Int      @default(10)
  /// Salon des annonces de montée de niveau (null = pas d'annonce)
  levelUpChannelId String?
  /// Salons où les commandes des membres sont autorisées (vide = partout) ; /admin n'est jamais limité
  commandChannelIds String[] @default([])
  /// Salon de comptage (null = désactivé) et amende en cas d'erreur
  countingChannelId String?
  countingFine     Int      @default(1000)
  /// Salon des annonces de succès (null = pas d'annonce)
  achievementChannelId String?
  /// Fonctionnalités désactivées par l'intendance (clés du registre src/modules/features)
  disabledFeatures String[] @default([])
  updatedAt        DateTime @updatedAt
}

/// Compte bancaire d'un membre. Le solde ne peut jamais être négatif (contrainte en base).
model Account {
  id           String        @id @default(cuid())
  memberId     String        @unique
  member       Member        @relation(fields: [memberId], references: [id])
  balance      Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

enum TransactionType {
  WELCOME
  DAILY
  WEEKLY
  PURCHASE
  REFUND
  BET
  BET_WIN
  GROUP_HUG
  DUEL_STAKE
  DUEL_WIN
  DUEL_REFUND
  LOTTERY_TICKET
  LOTTERY_WIN
  ADMIN_CREDIT
  ADMIN_DEBIT
  HUG_SENT
  HUG_RECEIVED
  ACHIEVEMENT
  COUNTING_FINE
}

/// Mouvement sur un compte : montant signé, solde résultant, auteur et motif.
model Transaction {
  id             String          @id @default(cuid())
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id])
  type           TransactionType
  delta          Int
  balanceAfter   Int
  reason         String?
  /// Discord ID de la personne à l'origine du mouvement
  actorDiscordId String
  /// Autre partie d'un câlin (Discord ID du destinataire ou de l'expéditeur)
  counterpartyDiscordId String?
  createdAt      DateTime        @default(now())

  @@index([accountId, createdAt(sort: Desc)])
}

/// Réclamation de la récompense quotidienne : une seule par membre et par jour civil.
model DailyClaim {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  /// Jour civil dans le fuseau du serveur, format AAAA-MM-JJ
  dayKey        String
  /// Nombre de jours consécutifs au moment de cette réclamation (1 = série entamée)
  streak        Int      @default(1)
  transactionId String   @unique
  createdAt     DateTime @default(now())

  @@unique([memberId, dayKey])
}

/// Réclamation de la récompense hebdomadaire : une seule par membre et par semaine civile.
model WeeklyClaim {
  id            String   @id @default(cuid())
  memberId      String
  member        Member   @relation(fields: [memberId], references: [id])
  /// Semaine ISO dans le fuseau du serveur, format AAAA-Wnn
  weekKey       String
  transactionId String   @unique
  createdAt     DateTime @default(now())

  @@unique([memberId, weekKey])
}

enum ItemKind {
  /// Objet de collection : simplement possédé, visible dans l'inventaire
  COLLECTIBLE
  /// Attribue un rôle Discord à l'achat
  ROLE
  /// Titre affichable sur le profil (le nom de l'article est le titre)
  TITLE
}

/// Article de la boutique, géré par les administrateurs.
model ShopItem {
  id           String    @id @default(cuid())
  guildId      String
  name         String
  description  String?
  emoji        String?
  price        Int
  kind         ItemKind  @default(COLLECTIBLE)
  /// Rôle Discord attribué à l'achat (kind = ROLE)
  roleId       String?
  /// Stock restant ; null = illimité
  stock        Int?
  /// Nombre maximal d'exemplaires par membre ; null = illimité
  maxPerMember Int?
  /// Un article retiré reste en base pour l'historique et les inventaires
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  titledMembers Member[] @relation("MemberTitle")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inventory    InventoryItem[]

  @@unique([guildId, name])
  @@index([guildId, active, sortOrder])
}

/// Exemplaires d'un article possédés par un membre.
model InventoryItem {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  itemId    String
  item      ShopItem @relation(fields: [itemId], references: [id])
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, itemId])
}

/// Présence en cours dans un salon vocal (persistée pour survivre aux redémarrages).
model VoiceSession {
  memberId   String   @id
  member     Member   @relation(fields: [memberId], references: [id])
  channelId  String
  startedAt  DateTime @default(now())
  /// Dernier instant jusqu'auquel le temps a été crédité
  lastTickAt DateTime @default(now())
}

enum BlackjackState {
  PLAYING
  WON
  LOST
  PUSH
  BLACKJACK
}

/// Partie de blackjack. La mise est débitée à la création ; le gain est crédité à la résolution.
model BlackjackGame {
  id             String         @id @default(cuid())
  memberId       String
  member         Member         @relation(fields: [memberId], references: [id])
  /// = memberId tant que la partie est en cours, null ensuite : garantit une seule partie active par membre
  activeMemberId String?        @unique
  bet            Int
  doubled        Boolean        @default(false)
  /// Cartes restantes du sabot, ex. ["A♠","10♥"]
  deck           Json
  playerCards    Json
  dealerCards    Json
  state          BlackjackState @default(PLAYING)
  /// Montant total rendu au joueur à la fin (0 si perdu)
  payout         Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([memberId, createdAt(sort: Desc)])
}

enum GroupHugState {
  OPEN
  CLOSED
}

/// Un câlin collectif lancé par Voltron dans un salon.
model GroupHug {
  id              String        @id @default(cuid())
  guildId         String
  channelId       String
  messageId       String?
  rewardPerHugger Int
  startedAt       DateTime      @default(now())
  endsAt          DateTime
  state           GroupHugState @default(OPEN)
  /// Récompense versée à chacun (fixée à la clôture)
  rewardEach      Int           @default(0)
  participants    GroupHugParticipant[]

  @@index([guildId, state])
}

model GroupHugParticipant {
  hugId    String
  hug      GroupHug @relation(fields: [hugId], references: [id])
  memberId String
  member   Member   @relation(fields: [memberId], references: [id])
  joinedAt DateTime @default(now())

  @@id([hugId, memberId])
}

/// Rôle attribué à partir d'un niveau. Seul le palier le plus élevé atteint est conservé.
/// Succès débloqué par un membre (clé du catalogue src/modules/achievements).
model MemberAchievement {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  key        String
  unlockedAt DateTime @default(now())

  @@unique([memberId, key])
  @@index([key])
}

/// État du salon de comptage : dernier nombre valide, dernier compteur, record.
model Counting {
  guildId      String  @id
  current      Int     @default(0)
  lastMemberId String?
  best         Int     @default(0)
  failures     Int     @default(0)
  updatedAt    DateTime @updatedAt
}

model LevelRole {
  id      String @id @default(cuid())
  guildId String
  level   Int
  roleId  String

  @@unique([guildId, level])
  @@unique([guildId, roleId])
}

/// Cagnotte progressive de la machine à sous, par serveur.
model SlotJackpot {
  guildId   String   @id
  pool      Int
  /// Dernier gagnant et date, pour l'affichage
  lastWinnerDiscordId String?
  lastWonAmount Int?
  lastWonAt DateTime?
  updatedAt DateTime @updatedAt
}

enum DuelState {
  PENDING
  RESOLVED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Duel entre deux membres. La mise du défieur est bloquée à la création, celle de l'adversaire à l'acceptation.
model Duel {
  id             String    @id @default(cuid())
  guildId        String
  channelId      String
  messageId      String?
  challengerId   String
  challenger     Member    @relation("DuelChallenger", fields: [challengerId], references: [id])
  opponentId     String
  opponent       Member    @relation("DuelOpponent", fields: [opponentId], references: [id])
  stake          Int
  state          DuelState @default(PENDING)
  winnerId       String?
  challengerRoll Int?
  opponentRoll   Int?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([guildId, state])
  @@index([challengerId, state])
}

enum LotteryState {
  OPEN
  DRAWN
}

/// Un tirage de tombola. La cagnotte = amorce + report éventuel + tickets vendus.
model Lottery {
  id            String       @id @default(cuid())
  guildId       String
  drawAt        DateTime
  state         LotteryState @default(OPEN)
  pot           Int          @default(0)
  ticketPrice   Int
  winnerMemberId String?
  winnerTickets Int?
  totalTickets  Int          @default(0)
  drawnAt       DateTime?
  createdAt     DateTime     @default(now())
  /// Dernier message publié (épinglé) pour ce tirage
  channelId     String?
  messageId     String?
  reminderSentAt DateTime?
  lastCallSentAt DateTime?
  entries       LotteryEntry[]

  @@index([guildId, state])
}

model LotteryEntry {
  lotteryId String
  lottery   Lottery @relation(fields: [lotteryId], references: [id])
  memberId  String
  member    Member  @relation(fields: [memberId], references: [id])
  tickets   Int     @default(0)

  @@id([lotteryId, memberId])
}
